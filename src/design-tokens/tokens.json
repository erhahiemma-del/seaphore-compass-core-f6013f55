{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seaphore/design-tokens.v1",
  "description": "Seaphore / NIMASA Copilot design tokens. Source of truth for --* CSS variables in src/styles.css. Do not hand-edit hex values in code — always add them here first and mirror them into @theme.",
  "meta": {
    "version": "1.0.0",
    "product": "NIMASA Copilot",
    "spec": "Volume I, Layer 3.3 — Design System"
  },
  "color": {
    "brand": {
      "navy":  { "value": "#0B1F3A", "role": "primary brand, sidebar" },
      "teal":  { "value": "#008B8B", "role": "action accent, focus rings" },
      "gold":  { "value": "#B8860B", "role": "highlight, awards" },
      "ink":   { "value": "#0F172A", "role": "body text on light" },
      "slate": { "value": "#64748B", "role": "muted text" }
    },
    "surface": {
      "background": { "value": "#F7F8FA" },
      "surface":    { "value": "#FFFFFF" },
      "surface-1":  { "value": "#FFFFFF", "role": "popovers, floating menus" },
      "surface-2":  { "value": "#F1F4F8", "role": "muted panels" },
      "line":       { "value": "#E4E8EC" }
    },
    "semantic": {
      "red":    { "value": "#DC2626", "role": "destructive, high risk" },
      "amber":  { "value": "#F59E0B", "role": "medium risk" },
      "green":  { "value": "#16A34A", "role": "success, low risk" },
      "blue":   { "value": "#2563EB" },
      "purple": { "value": "#7C3AED" }
    },
    "confidence": {
      "verified":    { "value": "#16A34A", "weight": 1.0 },
      "corroborated":{ "value": "#0E9F6E", "weight": 0.9 },
      "observed":    { "value": "#2563EB", "weight": 0.8 },
      "reported":    { "value": "#F59E0B", "weight": 0.5 },
      "inferred":    { "value": "#B45309", "weight": 0.3 },
      "unknown":     { "value": "#94A3B8", "weight": 0.0 }
    }
  },
  "typography": {
    "family": {
      "sans": { "value": "Inter, ui-sans-serif, system-ui, sans-serif" },
      "head": { "value": "\"Space Grotesk\", Inter, sans-serif" },
      "mono": { "value": "\"JetBrains Mono\", ui-monospace, monospace" }
    },
    "scale": {
      "xs":   { "size": "12px", "line": "16px" },
      "sm":   { "size": "13px", "line": "18px" },
      "base": { "size": "14px", "line": "20px" },
      "md":   { "size": "16px", "line": "24px" },
      "lg":   { "size": "18px", "line": "26px" },
      "xl":   { "size": "22px", "line": "30px" },
      "2xl":  { "size": "28px", "line": "36px" },
      "3xl":  { "size": "36px", "line": "44px" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "spacing": {
    "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"
  },
  "radius": {
    "sm": "4px", "md": "8px", "lg": "12px", "pill": "9999px"
  },
  "shadow": {
    "card": "0 1px 2px rgba(11, 31, 58, 0.04)",
    "pop":  "0 4px 14px rgba(0, 0, 0, 0.18)"
  },
  "z": {
    "base": 0, "sticky": 10, "dropdown": 40, "overlay": 50, "modal": 60, "toast": 70
  }
}
