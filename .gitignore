# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code — launch.json is the shared preview config and stays tracked.
# Everything else under .claude/ is per-machine: local permission settings and
# scratch worktrees.
.claude/*
!.claude/launch.json

# Environment — never commit real secrets.
# .env.example is the tracked template; .env is local-only.
.env
.env.local
.env.*.local
!.env.example

# Reports the application generates into the repository root.
#
# Exporting an ownership or compliance report writes the PDF beside the
# source tree, so a working session leaves artifacts behind that look
# like untracked files and get swept up by `git add -A`. Fifteen of them
# reached a commit that way.
#
# The four `seaphore-compliance-report-*.pdf` already tracked on main are
# deliberately left alone — ignoring a path does not untrack it, and
# removing someone else's committed files is not this rule's job.
Ownership_Evidence_Report_*.pdf
seaphore-compliance-report-*.pdf
