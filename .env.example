# Seaphore — Environment Reference (DEV-14)
# Copy this file to .env.local (git-ignored) for local overrides.
# Real values are injected by Lovable Cloud; never commit a populated .env.

# ---------- Browser (Vite) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------- Server runtime ----------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# ---------- AI Gateway ----------
LOVABLE_API_KEY=

# ---------- Copernicus Data Space Ecosystem (EP-COPERNICUS-01) ----------
# Register at: https://dataspace.copernicus.eu
# Provides: Sentinel-1, Sentinel-2 and all Copernicus satellite imagery metadata
# Authentication: OAuth 2.0 password-grant (token auto-refreshes every ~600 s)
#
# Quote the password. An unquoted `#` starts a comment, so a password
# containing one is silently truncated and the only symptom is an
# authentication failure that looks nothing like a config error.
#   COPERNICUS_PASSWORD="pa##word"
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ---------- Maritime Intelligence Core (INT-01A.1) ----------
# Default: true (enabled). Set to false to bypass MIC without code changes.
# Reads: process.env.MIC_ENABLED (server) / VITE_MIC_ENABLED (browser)
MIC_ENABLED=true

# ─── Global Fishing Watch ─────────────────────────────────────────────
# SERVER-ONLY. Never prefix with VITE_ — that publishes the secret in the
# client bundle. Read inside the execution boundary by
# src/lib/server/gfw.server.ts; the Authorization header never leaves it.
#
# Obtain: https://globalfishingwatch.org/our-apis/tokens (free tier is
# sufficient for the Gulf of Guinea area query).
# Legacy name GLOBAL_FISHING_WATCH_API_KEY is still accepted.
GFW_API_TOKEN=
